# GitHub Pages deployment allowlist.
# Ignore everything unless it is explicitly required by the published site.
*

# Repository deployment metadata
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

# Main static frontend
!/index.html
!/styles.css
!/app.js
!/hubei.geojson
!/requirements.txt
!/package.json
!/package-lock.json

# Reproducible geography build
!/scripts/
/scripts/*
!/scripts/build_display_areas.py
!/scripts/build_admin_boundary.py
!/scripts/extract_shuijiao_column.py

# Runtime font and its required license notice
!/assets/
/assets/*
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/SourceHanSerifCN-Prototype.woff2
!/assets/fonts/LICENSE.txt

# Runtime datasets
!/data/
/data/*
!/data/geography.json
!/data/display-groups.json
!/data/display_areas.geojson
!/data/display_areas_simplified.geojson
!/data/admin_boundary.geojson
!/data/extracted/
/data/extracted/*
!/data/extracted/ben.json
!/data/extracted/shuijiao.json

# Public documentation linked from the site
!/docs/
/docs/*
!/docs/README.md

# Ignore all WOFF2 font files
*.woff2
